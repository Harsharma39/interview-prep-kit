PORT=3000
CLIENT_ORIGIN=http://localhost:3001
MONGODB_URI=mongodb://localhost:27017/InterviewPrep
JWT_SECRET=replace-with-a-long-random-secret
COOKIE_SAME_SITE=Lax
NODE_ENV=development
JSON_BODY_LIMIT=1mb
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash
# Set true only for trusted direct research integration tests. Keep false in production.
ALLOW_PRIVATE_RESEARCH=false
# Set false to disable optional public interview-process lookups in offline tests.
PUBLIC_INTERVIEW_RESEARCH=true
